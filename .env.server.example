# Template .env.server — salin jadi `.env.server` di server, isi nilai asli.
# File .env.server asli JANGAN di-commit.

# Postgres (dipakai container wiwok-db)
POSTGRES_USER=wiwok
POSTGRES_PASSWORD=ganti-password-baru
POSTGRES_DB=wiwokdetok

# App (dipakai container wiwok-app) — password harus sama dengan POSTGRES_PASSWORD
DATABASE_URL=postgresql://wiwok:ganti-password-baru@wiwok-db:5432/wiwokdetok?schema=public

# WAJIB generate baru: openssl rand -hex 32
JWT_SECRET_KEY=

# Civitas dev instance (internal docker network wiwok-net)
EXTERNAL_AUTH_API_URL=http://civitas-dev:8081
EXTERNAL_AUTH_API_KEY=febrian
EXTERNAL_AUTH_API_SECRET=12345
