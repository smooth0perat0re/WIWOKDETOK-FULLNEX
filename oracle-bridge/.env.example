# Salin jadi .env (JANGAN di-commit). Kredensial Oracle sama yang dipakai
# service-civitas (schema EIS) — reuse nilai yang udah lo pegang.
ORACLE_USER=
ORACLE_PASS=
ORACLE_DSN=192.168.5.253:1521/orcl

# Shared secret dicek header X-Bridge-Key oleh wiwokdetok — generate sendiri,
# mis. `openssl rand -hex 32`. Harus sama dengan ORACLE_BRIDGE_KEY di .env wiwokdetok.
BRIDGE_API_KEY=
